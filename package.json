{
  "name": "3-shake-engineers-blogs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "run-s build:posts build:favicons build:feed build:next",
    "build:posts": "tsx ./src/builder/posts.ts",
    "build:favicons": "tsx ./src/builder/favicons.ts",
    "build:avatars": "tsx ./src/builder/avatars.ts",
    "build:feed": "NODE_ENV=production tsx ./src/builder/feed.ts",
    "build:next": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "feed": "6.0.0",
    "fs-extra": "11.4.1",
    "npm-run-all2": "9.0.3",
    "rss-parser": "3.13.0",
    "sass": "1.105.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
