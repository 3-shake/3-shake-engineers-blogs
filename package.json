{
  "name": "3-shake-engineers-blogs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "run-s build:posts build:favicons build:feed build:next",
    "build:posts": "tsx ./src/builder/posts.ts",
    "build:favicons": "tsx ./src/builder/favicons.ts",
    "build:avatars": "tsx ./src/builder/avatars.ts",
    "build:feed": "NODE_ENV=production tsx ./src/builder/feed.ts",
    "build:next": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "dayjs": "1.11.21",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "feed": "5.2.1",
    "fs-extra": "11.4.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "rss-parser": "3.13.0",
    "sass": "1.102.0",
    "tsx": "4.23.6",
    "typescript": "6.0.3"
  }
}
